NODE_ENV=development

# Web origins and API endpoints
USER_WEB_ORIGIN=http://localhost:3000
THERAPIST_WEB_ORIGIN=http://localhost:3001
ADMIN_WEB_ORIGIN=http://localhost:3002
API_BASE_URL=http://localhost:4000
API_HOST=127.0.0.1
API_PORT=3001
API_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars
API_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5176,http://127.0.0.1:5186,http://127.0.0.1:5187
API_STORAGE_MODE=memory
API_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuro_cog_rehab
API_POSTGRES_AUTO_MIGRATE=true

# Vite workspace URLs used by the unified role portal during local development.
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_TRAINEE_WEB_URL=http://127.0.0.1:5173
VITE_PARENT_WEB_URL=http://127.0.0.1:5173
VITE_THERAPIST_WEB_URL=http://127.0.0.1:5186
VITE_ADMIN_WEB_URL=http://127.0.0.1:5176

# Sensitive values must be replaced per environment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuro_cog_rehab
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# EEG simulator is enabled for MVP development before real device integration.
EEG_SIMULATOR_ENABLED=true
EEG_WS_PATH=/ws/eeg

# Reports and exports must respect role and data-scope permissions.
REPORT_JOB_CONCURRENCY=2
DATA_EXPORT_ENABLED=false
LOG_LEVEL=info
