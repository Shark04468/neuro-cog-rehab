{
  "name": "@neuro-cog-rehab/ui-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "corepack pnpm --filter @neuro-cog-rehab/game-core build && tsc -p tsconfig.json",
    "typecheck": "corepack pnpm --filter @neuro-cog-rehab/game-core build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@neuro-cog-rehab/game-core": "workspace:*",
    "@neuro-cog-rehab/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
