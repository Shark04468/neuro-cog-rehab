{
  "name": "@neuro-cog-rehab/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "corepack pnpm --filter @neuro-cog-rehab/api-server build && node dist/server.js",
    "typecheck": "corepack pnpm --filter @neuro-cog-rehab/shared-types build && tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm --filter @neuro-cog-rehab/shared-types build && vitest run"
  },
  "dependencies": {
    "@neuro-cog-rehab/shared-types": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
