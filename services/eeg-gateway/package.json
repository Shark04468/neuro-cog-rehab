    "start": "node dist/server.js"
  },
  "dependencies": {
    "@neuro-cog-rehab/eeg-features": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
