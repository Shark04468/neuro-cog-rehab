{
  "name": "@neuro-cog-rehab/eeg-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "corepack pnpm --filter @neuro-cog-rehab/eeg-features build && tsc -p tsconfig.json --noEmit",
